# Shared local config for Guardian-AI/RaGeX demo.
# Copy to .env and fill only local values. Do not commit .env.

# Ranbir RAG/dashboard service and Render Exasol backend
EXASOL_DSN=127.0.0.1:8563
EXASOL_USER=sys
EXASOL_PASSWORD=<exasol-password>
EXASOL_SCHEMA=GUARDIAN_AI
EXASOL_ENCRYPTION=true
EXASOL_COMPRESSION=true
EXASOL_CERTIFICATE_VALIDATION=false

GUARDIAN_AUTO_MIGRATE=true
GUARDIAN_STORAGE_BACKEND=auto
GUARDIAN_VECTOR_BACKEND=auto
GUARDIAN_EMBEDDING_PROVIDER=hash
GUARDIAN_EMBEDDING_DIM=768

LLM_CHAIN=groq,gemini,deterministic
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Divija local simulator/guardrail Exasol config
EXASOL_HOST=localhost
EXASOL_PORT=8563
INTEGRATION_URL=https://guardian-ai-ragex.onrender.com/integrations/guardrail-decision
